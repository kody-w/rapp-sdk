{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rapp:schema:spec-revision:1",
  "title": "RAPP specification revision payload profile",
  "description": "Payload profile carried by a RAPP/1 frame. The eleven-key RAPP/1 envelope is intentionally not redefined here.",
  "type": "object",
  "required": [
    "revision"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "canonical_repo": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*(?::443)?/(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))(?!.*[\\\\%?#\\u0000-\\u0020\\u007f])(?:[^/]+/)*[^/]+(?![\\s\\S])"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "normative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))(?!.*[\\\\%?#\\u0000-\\u0020\\u007f])(?:[^/]+/)*[^/]+(?![\\s\\S])"
    },
    "normative_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normative_bytes": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]|104857[0-6])(?![\\s\\S])"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      ]
    },
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "text",
        "sha256",
        "bytes"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[ -~]+(?![\\s\\S])"
        },
        "text": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "normative"
      ]
    },
    {
      "required": [
        "canonical_repo",
        "commit",
        "normative_path",
        "normative_sha256",
        "normative_bytes"
      ]
    }
  ],
  "dependentRequired": {
    "canonical_repo": [
      "commit",
      "normative_path",
      "normative_sha256",
      "normative_bytes"
    ],
    "commit": [
      "canonical_repo",
      "normative_path",
      "normative_sha256",
      "normative_bytes"
    ],
    "normative_path": [
      "canonical_repo",
      "commit",
      "normative_sha256",
      "normative_bytes"
    ],
    "normative_sha256": [
      "canonical_repo",
      "commit",
      "normative_path",
      "normative_bytes"
    ],
    "normative_bytes": [
      "canonical_repo",
      "commit",
      "normative_path",
      "normative_sha256"
    ]
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
