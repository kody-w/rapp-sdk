  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "track_slot",
        "ring",
        "ring_slot",
        "rappid",
        "paths",
        "artifact",
        "ports",
        "probes",
        "budgets"
      ],
      "properties": {
        "track": {
          "enum": [
            "frontier-experimental",
            "frontier",
            "brainstem-experimental",
            "brainstem-regular"
          ]
        },
        "track_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ring": {
          "enum": [
            "canary",
            "nightly",
            "alpha",
            "beta",
            "grail"
          ]
        },
        "ring_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "rappid": {
          "type": "string",
          "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}(?![\\s\\S])"
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "home",
            "state",
            "log",
            "cache",
            "tmp"
          ],
          "properties": {
            "home": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
              "description": "Normalized relative POSIX path using the documented ASCII path subset."
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
              "description": "Normalized relative POSIX path using the documented ASCII path subset."
            },
            "log": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
              "description": "Normalized relative POSIX path using the documented ASCII path subset."
            },
            "cache": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
              "description": "Normalized relative POSIX path using the documented ASCII path subset."
            },
            "tmp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
              "description": "Normalized relative POSIX path using the documented ASCII path subset."
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "argv"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4096,
                  "pattern": "^(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)+(?![\\s\\S])",
                  "description": "Artifact-relative executable path using the ASCII path subset; ambient PATH lookup is forbidden."
                }
              ],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[\\u0020-\\u007e]+(?![\\s\\S])",
                "description": "One non-empty printable ASCII argument."
              }
            }
          },
          "$comment": "The semantic validator additionally limits the aggregate argv encoding to 8192 ASCII bytes."
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gateway",
            "broker",
            "control",
            "metrics"
          ],
          "properties": {
            "gateway": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "broker": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "control": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "metrics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readiness",
            "liveness",
            "identity",
            "artifact"
          ],
          "properties": {
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint",
                "path",
                "timeout_ms",
                "interval_ms"
              ],
              "properties": {
                "endpoint": {
                  "enum": [
                    "gateway",
                    "broker",
                    "control",
                    "metrics"
                  ]
                },
                "path": {
                  "type": "string",
