{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rapp:schema:ring-yard-manifest:1",
  "title": "RAPP SDK ring-yard manifest",
  "description": "Closed rapp-ring-yard/1 structural and locally expressible validation. Conformance also requires the bundled semantic report API named by x-rapp-semantic-validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "yard",
    "control_plane",
    "cells"
  ],
  "properties": {
    "spec": {
      "const": "rapp-ring-yard/1"
    },
    "yard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "root"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
        },
        "root": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^/(?!/)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*(?:^|/)\\.\\.?(?:/|(?![\\s\\S])))[A-Za-z0-9._~!$&'()+,;=@-]+(?:/[A-Za-z0-9._~!$&'()+,;=@-]+)*(?![\\s\\S])",
          "description": "Normalized absolute POSIX path using the documented ASCII path subset."
        }
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduler",
        "plan"
      ],
      "properties": {
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "global_jobs",
            "per_track_jobs",
            "per_observer_jobs",
            "per_subject_jobs",
            "ready_queue"
          ],
          "properties": {
            "global_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "per_track_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "per_observer_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "per_subject_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "ready_queue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "$comment": "The semantic validator additionally requires each local limit to be no greater than global_jobs and ready_queue to be at least global_jobs."
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peer_jobs",
            "self_tests",
            "total_jobs"
          ],
          "properties": {
            "peer_jobs": {
              "const": 380
            },
            "self_tests": {
              "const": 20
            },
            "total_jobs": {
              "const": 400
            }
          }
        }
      }
    },
